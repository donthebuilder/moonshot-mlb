# vercel
.vercel

# bot repo clone lives here for convenience — it is its own git repo,
# never part of the site build. Tracking it as a gitlink made Vercel try
# to fetch it as a submodule every deploy (2026-08-08 warning fix).
bot-ship/

# local render fixture (scripts/dev-fixture.mjs regenerates it)
public/__devfixture/
.env*

# local scratch that must never reach the remote (2026-09-03)
# ARCHIVE/ is 267MB and itself/ is 64MB — a single `git add -A` would try to
# push both and GitHub would reject the largest files outright.
ARCHIVE/
itself/
Claude outputs/
_to_delete/

# Called It — X keys, kept out of git (SHIP-CALLEDIT.sh)
.calledit.env

# Scratch that Claude sessions move aside because `rm` is not permitted
# through the desktop file bridge (stale .next builds, stale git lock files).
# Safe to delete by hand at any time; never source.
_to_delete*

# supabase CLI local state (regenerated on every `supabase` command)
supabase/.temp/

# Donovan's local archive of already-run/folded-in one-time SHIP scripts --
# real reference material, not source; keeps `git status` from listing 70+
# historical deploy scripts as untracked noise (2026-09-14)
SHIP-SCRIPTS-ARCHIVE/

# secrets backups — the .bak that leaked 2026-09-24
.calledit.env*
*.env.bak

# Claude Code local notes and personal settings (2026-09-25)
.claude-notes/
.claude/settings.local.json
CLAUDE.local.md
