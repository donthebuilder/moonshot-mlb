NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRANCHISE_CRON_SECRET=generate-a-long-random-secret
# Vercel Cron sends only CRON_SECRET automatically. It can use the same
# generated value as FRANCHISE_CRON_SECRET.
CRON_SECRET=generate-a-long-random-secret

# Homer feed — the public X / Discord home run tracker (app/api/dash/homers/tick).
# X: app "Keys and tokens", permissions READ AND WRITE before minting the access token.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# @handle credited on each post (optional)
X_HANDLE=@CalledItHR
# flagged = only homers the bot called go to X (fits the free tier); all = every homer
X_POST_MODE=all
# Discord channel webhook; gets every homer regardless of X_POST_MODE
DISCORD_HOMER_WEBHOOK=

# Notification catalog (app/api/dash/push/tick) mirrored to Discord — the same
# MLB + NFL alerts that go out as web push, broadcast (not per-user) to one or
# more servers. Comma- or newline-separated webhook URLs; every one gets every
# event unless the sport-specific var below is set.
DISCORD_ALERTS_WEBHOOKS=
# Optional per-sport override — set either to peel that sport onto its own
# server(s) later without touching code. Leave blank to keep using the line above.
DISCORD_MLB_WEBHOOKS=
DISCORD_NFL_WEBHOOKS=
