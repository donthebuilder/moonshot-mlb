{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install --no-audit --no-fund",
  "crons": [
    { "path": "/api/dash/push/tick", "schedule": "*/10 16-23 * * *" },
    { "path": "/api/dash/push/tick", "schedule": "*/10 0-6 * * *" }
  ]
}
