{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install --no-audit --no-fund",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/dash/push/tick",
      "schedule": "* 17-23 * * *"
    },
    {
      "path": "/api/dash/push/tick",
      "schedule": "* 0-7 * * *"
    },
    {
      "path": "/api/fantasy/scoring",
      "schedule": "*/10 17-23 * * *"
    },
    {
      "path": "/api/fantasy/scoring",
      "schedule": "*/10 0-7 * * *"
    },
    {
      "path": "/api/fantasy/scoring",
      "schedule": "0 8-16 * * *"
    },
    {
      "path": "/api/dash/push/tick",
      "schedule": "* 13-16 * * 0"
    },
    {
      "path": "/api/fantasy/scoring",
      "schedule": "*/10 13-16 * * 0"
    },
    {
      "path": "/api/dash/sim-log",
      "schedule": "0 15-23 * * *"
    },
    {
      "path": "/api/dash/sim-log",
      "schedule": "0 0-2 * * *"
    },
    {
      "path": "/api/fantasy/draft-tick",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/dash/homers/tick",
      "schedule": "* 17-23 * * *"
    },
    {
      "path": "/api/dash/homers/tick",
      "schedule": "* 0-7,10-12 * * *"
    },
    {
      "path": "/api/dash/homers/tick",
      "schedule": "* 13-16 * * *"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 22-23 * * 4"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 0-5 * * 5"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 13-23 * * 6"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 0-5 * * 0"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 13-23 * * 0"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 0-5 * * 1"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 0-5,14-16 * * 2"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 14-17 * * 3"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 14-16 * * 4"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 14-16 * * 5"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 13-16 * * 1"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 22-23 * * 1"
    },
    {
      "path": "/api/dash/nfl/tick",
      "schedule": "* 12 * * 0"
    },
    {
      "path": "/api/lamp/tick",
      "schedule": "*/10 15-23 * * *"
    },
    {
      "path": "/api/lamp/goals/tick",
      "schedule": "* 16-23 * * *"
    },
    {
      "path": "/api/lamp/goals/tick",
      "schedule": "* 0-6 * * *"
    },
    {
      "path": "/api/dash/push/tick",
      "schedule": "* 16 * * 6"
    },
    {
      "path": "/api/lamp/tick",
      "schedule": "*/10 0-7 * * *"
    },
    {
      "path": "/api/odds/tick",
      "schedule": "*/10 11-23 * * *"
    },
    {
      "path": "/api/odds/tick",
      "schedule": "*/10 0-5 * * *"
    },
    {
      "path": "/api/gh/dispatch",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/multi/tick",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/facts/tick",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/buckets/tick",
      "schedule": "*/10 15-23,0-6 * * *"
    },
    { "path": "/api/dash/polls/tick", "schedule": "*/10 13-23,0-5 * * *" },
    { "path": "/api/totals/tick", "schedule": "*/10 13-23,0-9 * * *" },
    { "path": "/api/buckets/moments", "schedule": "* 16-23 * * *" },
    { "path": "/api/buckets/moments", "schedule": "* 0-6 * * *" }
  ]
}
